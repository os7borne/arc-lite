{
  "manifest_version": 3,
  "name": "Arc Lite",
  "version": "1.6.0",
  "description": "Arc-style action bar: copy URL (Cmd+Shift+C) and downloads.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen",
    "downloads",
    "downloads.open",
    "downloads.ui",
    "tabs",
    "storage",
    "tabGroups",
    "history",
    "topSites",
    "search",
    "sessions",
    "favicon",
    "unlimitedStorage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Arc Lite",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "copy-url": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Copy current tab URL"
    },
    "open-command-bar": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open the command bar"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "settings.js",
        "action-bar.js",
        "buttons/media.js",
        "buttons/downloads.js",
        "buttons/copy-url.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "media-agent.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "settings.js",
        "command-bar.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "commandbar.html"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ]
}
